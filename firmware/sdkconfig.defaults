# Waveshare official LVGL-example baseline: conservative 16 MB map on 32 MB flash, 8 MB OPI PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Native USB Audio Class microphone for macOS Desktop Voice.
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_SUPPORT_MACOS=y
CONFIG_UAC_TUSB_MANUFACTURER="Codex ESP32 Display"
CONFIG_UAC_TUSB_PRODUCT="Waveshare Voice Microphone"
CONFIG_UAC_TUSB_SERIAL_NUM="CESP32VOICE01"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Keep general-purpose LVGL allocations in PSRAM so internal RAM remains
# available for the display driver's DMA staging buffers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
# Keep each partial QSPI flush small enough for the internal DMA staging pool.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=20
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"

CONFIG_CODEX_ATTENTION_WIFI_SSID="CHANGE_ME"
CONFIG_CODEX_ATTENTION_WIFI_PASSWORD=""
CONFIG_CODEX_ATTENTION_BRIDGE_URL=""
CONFIG_CODEX_ATTENTION_BRIDGE_TOKEN=""
CONFIG_CODEX_ATTENTION_POLL_INTERVAL_MS=2000
CONFIG_CODEX_ATTENTION_MAX_ITEMS=20

# Wireless microphone is opt-in at runtime until a local pairing bundle is
# provisioned into firmware/sdkconfig.wireless.defaults.
CONFIG_CODEX_ATTENTION_WIRELESS_ENABLED=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# Audio, USB, Wi-Fi and DMA already use internal RAM. TLS needs a contiguous
# 16 KiB receive buffer plus its handshake allocations; use the board's PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Incoming control reads must not hold the lock needed by 20 ms audio sends.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_CODEX_ATTENTION_VOICE_TRANSPORT_AUTO=y
CONFIG_CODEX_ATTENTION_WIRELESS_URL=""
CONFIG_CODEX_ATTENTION_WIRELESS_SERVER_NAME=""
CONFIG_CODEX_ATTENTION_WIRELESS_CA_PEM=""
CONFIG_CODEX_ATTENTION_WIRELESS_CREDENTIAL=""
CONFIG_CODEX_ATTENTION_WIRELESS_DEVICE_ID="CESP32VOICE01"

# Attention pairing uses a dedicated encrypted NVS partition. Firmware only
# READS an existing HMAC_UP key. Factory/owner provisioning is a separate step.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
# Sentinel outside HMAC_KEY_MAX: accidental default encrypted-NVS init must
# fail rather than generate/burn a key. The pairing partition uses block 5 below.
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=6
CONFIG_CODEX_ATTENTION_PAIRING_HMAC_KEY_ID=5
# UART0 maintenance provisioning is independent of native TinyUSB UAC.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
